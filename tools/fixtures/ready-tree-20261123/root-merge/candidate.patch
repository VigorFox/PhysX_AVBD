+bool AvbdDynamicsContext::prepareReadyGroup(const PxArray<PxU32>& blocks,PxU32 end,PxU32 limit)
+{
+    auto& work=*mLocalWork;
+    PxU32 leaves=0,slots=0;
+    bool nodes=false,rigids=false;
+    while(work.cursor<end && slots<limit && !mLocalDomainFailed)
+    {
+        const PxU32 b=blocks[work.cursor];
+        if(b>=mBlocks.size()){++work.cursor;continue;}
+        const PxU32 lo=mRowProgram.blockOffsets[b],hi=mRowProgram.blockOffsets[b+1];
+        const PxU32 rows=hi-lo;
+        if(rows<=AvbdLocalWork::RowLimit){++work.cursor;continue;}
+        if(limit>1 && limit-slots==1)break;
+        ++work.cursor;
+        auto& block=*work.blocks.insert();
+        block.state.body=b;
+        if(b<mBodies.size()){block.state.original=PxTransform(mBodies[b].p,mBodies[b].q);rigids=true;}
+        else nodes=true;
+        block.begin=lo;block.end=hi;block.count=1+(rows-1)/AvbdLocalWork::RowLimit;
+        block.rootStride=1u<<PxHighestSetBit(block.count-1);
+        block.scratch=leaves;leaves+=block.count;
+        block.slot=slots;block.slots=PxMin(block.count,limit-slots);slots+=block.slots;
+        ++mStep.tiledBlocks;++mStep.localBlocks;mStep.tiledLeaves+=block.count;
+        mStep.tiledMaxRows=PxMax(mStep.tiledMaxRows,rows);
+    }
+    if(work.blocks.empty())return false;
+    work.pending.clear();work.pending.resize(leaves,2);
+    if(nodes){work.nodal.resize(leaves);work.energy.resize(leaves);}
+    if(rigids)work.rigid.resize(leaves);
+    while(work.tasks.size()+1<slots)
+        work.tasks.pushBack(PX_NEW(AvbdReadyLeafTask)(*this,mContextID));
+    const PxU64 bytes=PxU64(work.blocks.capacity())*sizeof(AvbdReadyWork::Block)+
+        PxU64(work.pending.capacity())*sizeof(PxI32)+PxU64(work.nodal.capacity())*sizeof(AvbdNodalAssembly)+
+        PxU64(work.energy.capacity())*sizeof(AvbdNodalEnergy)+PxU64(work.rigid.capacity())*sizeof(AvbdLocalPartial)+
+        PxU64(work.tasks.capacity())*sizeof(AvbdReadyLeafTask*)+PxU64(work.tasks.size())*sizeof(AvbdReadyLeafTask);
+    mStep.tiledScratchBytes=PxMax(mStep.tiledScratchBytes,bytes);
+    mStep.localQueuePeak=PxMax(mStep.localQueuePeak,slots);
+    return true;
+}
