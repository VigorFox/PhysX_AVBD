+// One task per active leaf slot. A block can reuse its slots only after
+// every release in its own window, independently of other same-color blocks.
+class AvbdReadyLeafTask : public Cm::Task, public PxUserAllocated
+{
+    AvbdDynamicsContext& mContext;
+public:
+    PxU32 owner=0, leaf=0;
+    AvbdReadyLeafTask(AvbdDynamicsContext& context,PxU64 id):Cm::Task(id),mContext(context) {}
+    void runInternal() PX_OVERRIDE { mContext.runReadyLeaf(owner,leaf); }
+    void submit(PxTaskManager& manager)
+    {
+        mTm=&manager;
+        manager.getCpuDispatcher()->submitTask(*this);
+    }
+    void release() PX_OVERRIDE;
+    const char* getName() const PX_OVERRIDE { return "AVBD.localTreeLeaf"; }
+};
+
+struct AvbdReadyWork : PxUserAllocated
+{
+    struct Block
