+        AvbdLocalBlockState state;
+        AvbdNodalTrial nodalTrial;
+        PxU32 begin=0,end=0,count=0,rootStride=0,scratch=0,slot=0,slots=0;
+        PxU32 next=0,inlineLeaf=0,attempt=0,windows=0,external=0;
+        PxU64 jobs=0;
+        volatile PxI32 remaining=0;
+    };
+    PxArray<Block> blocks;
+    PxArray<AvbdReadyLeafTask*> tasks;
+    PxArray<PxI32> pending;
+    PxArray<AvbdNodalAssembly> nodal;
+    PxArray<AvbdNodalEnergy> energy;
+    PxArray<AvbdLocalPartial> rigid;
+    PxU32 cursor=PX_MAX_U32;
+    PxU64 start=0,cohorts=0,multiBlockCohorts=0;
+    ~AvbdReadyWork() { for(auto* task:tasks)PX_DELETE(task); }
+};
