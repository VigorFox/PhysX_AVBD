+void AvbdDynamicsContext::mergeReadyChildren(PxU32 owner,PxU32 a,PxU32 b)
+{
+    auto& work=*mLocalWork;
+    const auto& block=work.blocks[owner];
+    const bool nodal=block.state.body>=mBodies.size(),trial=block.attempt!=0;
+    if(!nodal)
+    {
+        AvbdLocalReductionArgs args={&work.rigid[a],&work.rigid[b],&work.rigid[a],trial};
+        mKernels.launch(AVBD_LOCAL_REDUCTION,&args);
+    }
+    else if(trial)
+    {
+        work.energy[a].energy+=work.energy[b].energy;
+        work.energy[a].valid&=work.energy[b].valid;
+    }
+    else work.nodal[a].add(work.nodal[b]);
+}
+
+// The right child's first leaf uniquely identifies each binary join. Odd
+// tails advance without allocating or copying a unary partial. Only the last
+// child writes the parent, and the next trial starts after every leaf release.
+void AvbdDynamicsContext::runReadyLeaf(PxU32 owner,PxU32 leaf)
+{
+    auto& work=*mLocalWork;
+    const auto& block=work.blocks[owner];
+    const auto& state=block.state;
+    const bool nodal=state.body>=mBodies.size(),trial=block.attempt!=0;
+    const PxU32 begin=block.begin+leaf*AvbdLocalWork::RowLimit;
+    const PxU32 end=begin+PxMin(PxU32(AvbdLocalWork::RowLimit),block.end-begin);
+    const PxU32 slot=block.scratch+leaf;
+    const PxU64 start=mStep.profile?PxTime::getCurrentCounterValue():0;
+    if(mStep.countNodalSolves)PxAtomicMax(&mPeakPrimalTasks,PxAtomicIncrement(&mActivePrimalTasks));
+    if(!nodal)sampleLocalBlock(state,begin,end,work.rigid[slot],trial);
+    else if(trial)sampleNodalTrial(state.body,begin,end,block.nodalTrial,work.energy[slot]);
+    else
+    {
+        work.nodal[slot]=AvbdNodalAssembly();
+        assembleNodalRows(state.body,begin,end,work.nodal[slot]);
+    }
+    for(PxU32 stride=1;stride<block.rootStride;stride*=2)
+    {
+        const PxU32 left=leaf & ~(2*stride-1),right=left+stride;
+        if(right>=block.count)continue;
+        const PxU32 a=block.scratch+left,b=block.scratch+right;
+        if(PxAtomicDecrement(&work.pending[b]))break;
+        mergeReadyChildren(owner,a,b);
+        work.pending[b]=2;
+    }
+    if(mStep.countNodalSolves)PxAtomicDecrement(&mActivePrimalTasks);
+    if(mStep.profile)PxAtomicAdd(&mStep.localTaskTicks[3],PxI64(PxTime::getCurrentCounterValue()-start));
+}
+
+void AvbdDynamicsContext::issueReadyWindow(PxU32 owner)
+{
+    auto& work=*mLocalWork;
+    auto& block=work.blocks[owner];
+    const PxU32 first=block.next,count=PxMin(block.slots,block.count-first);
+    block.next+=count;
+    block.inlineLeaf=first;
+    block.remaining=PxI32(count); // caller's leaf holds the window open during submission
+    ++block.windows;
+    block.jobs+=count;
+    block.external+=count-1;
+    for(PxU32 i=1;i<count;++i)
+    {
+        auto* task=work.tasks[block.slot+i-1];
+        task->owner=owner;task->leaf=first+i;
+        task->submit(*mStep.continuation->getTaskManager());
+    }
+}
+
+bool AvbdDynamicsContext::advanceReadyBlock(PxU32 owner)
+{
+    auto& work=*mLocalWork;
+    auto& block=work.blocks[owner];
+    auto& state=block.state;
+    while(!mLocalDomainFailed)
+    {
+        if(block.next==block.count)
+        {
+            const PxU64 start=mStep.profile?PxTime::getCurrentCounterValue():0;
+            // count-1 binary merges and one direction/accept for a full pass.
+            block.jobs+=block.count;
+            // The last leaf release already joined both root subtrees.
+            mergeReadyChildren(owner,block.scratch,block.scratch+block.rootStride);
+            if(state.body<mBodies.size())
+            {
+                if(block.attempt)finishLocalBlockTrial(state,work.rigid[block.scratch]);
+                else directLocalBlock(state,work.rigid[block.scratch]);
+            }
+            else
+            {
+                auto& trial=block.nodalTrial;
+                const auto& rows=work.nodal[block.scratch];
+                if(block.attempt)acceptNodalTrial(state.body,rows,trial,work.energy[block.scratch]);
+                else beginNodalTrial(state.body,rows,trial);
+                state.done=trial.done;
+            }
+            if(mStep.profile)PxAtomicAdd(&mStep.localTaskTicks[3],PxI64(PxTime::getCurrentCounterValue()-start));
+            if(state.done || mLocalDomainFailed || block.attempt==AvbdLocalWork::SearchLimit)
+            {
+                state.done=true;
+                break;
+            }
+            ++block.attempt;
+            block.next=0;
+        }
+        // An oversized star or a difficult search can be resumed after
+        // this group drains. Bound work even when submitTask runs inline.
+        if(block.windows==LocalQueueDepth)return true;
+        issueReadyWindow(owner);
+        runReadyLeaf(owner,block.inlineLeaf);
+        if(PxAtomicDecrement(&block.remaining))return false;
+    }
+    return true;
+}
