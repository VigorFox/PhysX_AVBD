+void AvbdReadyLeafTask::release()
+{
+    const PxU32 block=owner;
+    auto& state=mContext.mLocalWork->blocks[block];
+    if(PxAtomicDecrement(&state.remaining)==0)
+    {
+        PX_SIMD_GUARD;
+        if(mContext.advanceReadyBlock(block))
+            mContext.mColorContinuation->removeReference();
+    }
+}
