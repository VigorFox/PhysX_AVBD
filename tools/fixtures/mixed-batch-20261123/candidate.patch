+bool AvbdDynamicsContext::submitMixedColorWave(PxU32 firstTile,PxU32 tiles,PxU32 leaves)
+{
+    auto& plan=*mColorTasks;
+    auto& mixed=plan.mixed;
+    const PxU32 count=tiles+leaves;
+    // Aim for one spare claim per four items on narrow waves. Wide waves use
+    // every worker. A lane always owns its first ticket, including inline.
+    const PxU32 lanes=PxMin(plan.workers,PxMax(2u,(3*count+3)/4));
+    PX_ASSERT(tiles && leaves && lanes<=count && count<=lanes*LocalQueueDepth);
+    PX_ASSERT(mLocalWork->phase==AvbdLocalWork::Assemble);
+    mixed.firstTile=firstTile;
+    mixed.tiles=tiles;
+    mixed.firstLeaf=mLocalWork->cursor;
+    mixed.leaves=leaves;
+    mixed.lanes=lanes;
+    mLocalWork->cursor+=leaves;
+    mStep.tiledJobs+=leaves;
+    mStep.localQueuePeak=PxMax(mStep.localQueuePeak,lanes);
+    if(!mColorContinuation)mColorContinuation=PX_NEW(AvbdAdvanceTask)(*this,mContextID);
+    while(mixed.tasks.size()+1<lanes)
+        mixed.tasks.pushBack(PX_NEW(AvbdMixedColorLane)(*this,mContextID,mixed.tasks.size()+1));
+    auto* join=mColorContinuation;
+    join->reserveWave(*mStep.continuation->getTaskManager(),lanes);
+    mStep.submittedTasks+=lanes-1;
+    if(mStep.profile)
+    {
+        mStep.localWaveStart=PxTime::getCurrentCounterValue();
+        mStep.localWaveStage=0;
+        mStep.localWaveJobs=mStep.localWaveTaskCount=lanes;
+        if(mStep.localTimeline)
+        {
+            plan.wait.inlineSlot=0;
+            ++plan.claims.waves;
+            plan.claims.lanes+=lanes;
+            plan.claims.tiles+=tiles;
+            plan.claims.leaves+=leaves;
+        }
+    }
+    for(PxU32 slot=1;slot<lanes;++slot)
+    {
+        if(mStep.localTimeline)mStep.localWaveTaskReady[slot]=PxTime::getCurrentCounterValue();
+        mixed.tasks[slot-1]->submit(*join);
+    }
+    if(mStep.localTimeline)mStep.localWaveTaskReady[0]=PxTime::getCurrentCounterValue();
+    runMixedColorLane(0);
+    const bool complete=join->completeInline();
+    if(complete)finishLocalProfileWave();
+    return complete;
+}
+
+void AvbdDynamicsContext::runMixedColorLane(PxU32 slot)
+{
+    const auto started=mStep.profile?PxTime::getCurrentCounterValue():0;
+    auto& plan=*mColorTasks;
+    auto& mixed=plan.mixed;
+    const PxU32 count=mixed.tiles+mixed.leaves, pairs=PxMin(mixed.tiles,mixed.leaves);
+    auto hottest=StepState::HotItem{};
+    PxU64 wait=0;
+    // Earlier submissions receive any extra item. The caller starts its
+    // inline batch after the submissions, so it takes the final range.
+    const PxU32 rank=slot ? slot-1 : mixed.lanes-1;
+    const PxU32 perLane=count/mixed.lanes, extra=count%mixed.lanes;
+    const PxU32 begin=rank*perLane+PxMin(rank,extra);
+    const PxU32 claimed=perLane+(rank<extra ? 1u : 0u);
+    PX_ASSERT(claimed && claimed<=LocalQueueDepth);
+    for(PxU32 ticket=begin;ticket<begin+claimed;++ticket)
+    {
+        // Interleave the first pairs, then consume the longer span. Each
+        // ticket addresses exactly one original tile or exclusive tree leaf.
+        const bool leaf=ticket<2*pairs?(ticket%2==0):mixed.leaves>mixed.tiles;
+        const PxU32 ordinal=ticket<2*pairs?ticket/2:ticket-pairs;
+        const PxU32 index=leaf?mixed.firstLeaf+ordinal:mixed.firstTile+ordinal;
+        if(mStep.localTimeline)wait+=PxTime::getCurrentCounterValue()-mStep.localWaveStart;
+        solveLocalBatch(index,index+1,leaf?3:0,slot);
+        if(mStep.profile)
+        {
+            if(leaf)
+            {
+                const auto& n=mLocalWork->nodes[mLocalWork->leaves[index]];
+                mStep.hotItems[slot]={mStep.localWaveTaskTicks[slot],
+                    mLocalWork->states[n.state].body<mBodies.size()?0u:1u,n.end-n.begin};
+            }
+            if(mStep.hotItems[slot].ticks>hottest.ticks)hottest=mStep.hotItems[slot];
+        }
+    }
+    if(mStep.profile)
+    {
+        mStep.localWaveTaskStarts[slot]=started;
+        mStep.localWaveTaskTicks[slot]=PxTime::getCurrentCounterValue()-started;
+        mStep.hotItems[slot]=hottest;
+        if(mStep.localTimeline)
+        {
+            PxAtomicAdd(&plan.claims.itemWaitTicks,PxI64(wait));
+            PxAtomicAdd(&plan.claims.claimed,PxI32(claimed));
+            PxAtomicMax(&plan.claims.maxClaimed,PxI32(claimed));
+        }
+    }
+}
